# brig·id seedling as a systemd service.
#
# Written by `seedling init --systemd`, with the path of the executable and of
# the master key filled in. The server runs as the unprivileged user `brigid`
# (deploy/systemd/brigid.conf, for systemd-sysusers), never as root; the
# master key stays a root-only file that systemd hands to the service alone.
[Unit]
Description=brig·id seedling, a passkey sign-in server
Documentation=https://github.com/brig-id/server-seedling
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=brigid
Group=brigid
ExecStart=/usr/local/bin/seedling
# The configuration is /etc/brigid/seedling.toml, read by default.
# The key reaches the service and nothing else.
LoadCredential=master.key:/etc/brigid/master.key
Environment=BRIGID_MASTER_KEY_FILE=%d/master.key
# /var/lib/brigid, created for the service and owned by it.
StateDirectory=brigid
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s

# Ports below 1024 (443) without root: this capability, and no other.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The rest of the machine is out of reach.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
